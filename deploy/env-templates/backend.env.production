# Production environment for the Django API.
# Copy to /srv/msu/Backend/.env on the server, then fill in the two secrets.
#
#   sudo -u msu cp /srv/msu/deploy/env-templates/backend.env.production /srv/msu/Backend/.env
#   sudo -u msu chmod 600 /srv/msu/Backend/.env
#
# This file contains database credentials — never commit the filled-in version.

# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Django refuses to start with DEBUG=False and no SECRET_KEY, by design.
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# Must be False in production. With DEBUG=True Django serves full stack traces
# and your settings to anyone who triggers an error.
DEBUG=False

# Requests with a Host header outside this list are rejected with a 400.
# Included beyond the real domain:
#   server1... and the IP  - so you can verify before DNS propagates
#   127.0.0.1 and localhost - so local health checks work whichever name you use
# All are loopback or this server's own addresses, so they are safe to keep.
ALLOWED_HOSTS=collectmytranscriptmsu.com,www.collectmytranscriptmsu.com,server1.collectmytranscriptmsu.com,198.54.112.154,127.0.0.1,localhost

# Required for the Django admin login form to accept POSTs over HTTPS.
CSRF_TRUSTED_ORIGINS=https://collectmytranscriptmsu.com,https://www.collectmytranscriptmsu.com

# Empty: nginx serves the frontend and the API from the same origin, so the
# browser never makes a cross-origin request. Leave this blank unless you split
# the API onto its own subdomain.
CORS_ALLOWED_ORIGINS=

# nginx already redirects http -> https. Leave False so the redirect is not
# handled twice.
SECURE_SSL_REDIRECT=False

# PostgreSQL, running locally on this same server.
POSTGRES_DB=msu_transcripts
POSTGRES_USER=msu_transcripts
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Public address of the site, used to build the password-reset link in emails.
FRONTEND_URL=https://collectmytranscriptmsu.com

# Outgoing email for password resets. Leave EMAIL_HOST empty and reset emails are
# only printed to the service log (journalctl -u msu-backend).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MSU Transcript <noreply@collectmytranscriptmsu.com>

# ---------------------------------------------------------------- security

# Admins and staff must use a second sign-in factor (authenticator app). Keep
# True in production; each person sets it up at their first sign-in.
REQUIRE_MFA=True

# Public lookups (status check and lost reference): attempts per address per
# window. The 11th lookup within 10 minutes is refused.
LOOKUP_RATE_LIMIT=10
LOOKUP_WINDOW_SECONDS=600

# Optional Cloudflare Turnstile bot check on the request form. Leave empty to
# rely on the honeypot field and the submission rate limit.
TURNSTILE_SECRET=

# -------------------------------------------------------- files and alerts

# Clearance uploads. Never inside a directory nginx serves.
PRIVATE_MEDIA_ROOT=/srv/msu/Backend/private_media

# Server errors and browser errors are emailed here straight away (needs
# EMAIL_HOST above). Format: Name <email>, Name <email>
ADMINS=Operations <ops@collectmytranscriptmsu.com>
SERVER_EMAIL=alerts@collectmytranscriptmsu.com

# ---------------------------------------------------- messages to graduates

# Automatic SMS at each stage. Any provider with an HTTP API that accepts JSON
# {"to", "message", "sender"} and a bearer key. Leave SMS_API_URL empty and
# messages are logged as "not sent" (Reports > Messages) instead.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=MSUTRANSCR

# ------------------------------------------------------------------ backups

# rclone remote for off-site copies of the nightly backup, e.g. b2:msu-backups
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30
