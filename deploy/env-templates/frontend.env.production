# Production environment for the frontend build.
# Copy to /srv/msu/Frontend/.env on the server BEFORE building:
#
#   sudo -u msu cp /srv/msu/deploy/env-templates/frontend.env.production /srv/msu/Frontend/.env
#
# VITE_* values are baked into the JavaScript bundle at build time, not read at
# runtime. Changing this file has no effect until you rebuild
# (`npm run build:server`) and restart msu-frontend.

# A relative path, on purpose. nginx serves the app and proxies /api to Django
# on the same origin, so the browser resolves this against whatever host it
# loaded the page from. That means:
#   - no CORS configuration anywhere
#   - no hard-coded domain, so staging and production use the same build
VITE_API_URL="/api"
