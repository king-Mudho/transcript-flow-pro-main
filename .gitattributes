# Server scripts and config run on Linux: always LF, even when checked out or
# archived on Windows. CRLF here breaks bash ("$'\r': command not found").
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
*.production    text eol=lf
deploy/**       text eol=lf
